@page
@model JobsModel
@{
    ViewData["Title"] = "SQL Server Agent Jobs";
}

<h1>SQL Server Agent Jobs</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (!Model.Jobs.Any())
{
    <p class="text-muted">No SQL Server Agent jobs found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Job Name</th>
                <th>Status</th>
                <th>Last Run</th>
                <th>Last Run Date/Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr>
                    <td>@job.JobName</td>
                    <td>
                        @if (job.IsEnabled)
                        {
                            <span class="badge bg-success">Enabled</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = job.LastRunStatus switch
                            {
                                "Succeeded" => "bg-success",
                                "Failed"    => "bg-danger",
                                "In Progress" => "bg-primary",
                                "Retry"     => "bg-warning text-dark",
                                "Cancelled" => "bg-warning text-dark",
                                _           => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@job.LastRunStatus</span>
                    </td>
                    <td>
                        @if (job.LastRunDateTime.HasValue)
                        {
                            @job.LastRunDateTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">Showing @Model.Jobs.Count job(s). Page refreshed at @DateTime.Now.ToString("HH:mm:ss").</p>
}
