@page
@model JobDetailsModel
@{
    ViewData["Title"] = $"Job Details – {Model.JobName}";
    var jobRuns = Model.History.Where(h => h.StepId == 0).ToList();
    var stepRuns = Model.History.Where(h => h.StepId != 0).ToList();
}

<style>
    .detail-stat { border-radius: .75rem; padding: 1rem 1.25rem; background: #f8f9fa; border: 1px solid #e9ecef; }
    .detail-stat .ds-value { font-size: 1.6rem; font-weight: 700; }
    .detail-stat .ds-label { font-size: .78rem; color: #6c757d; margin-top: .15rem; }
    .section-card { border: none; border-radius: .75rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 1.5rem; }
    .section-card .card-header { background: transparent; border-bottom: 1px solid #f0f0f0; font-weight: 600; }
    .table th { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: #6c757d; }
    .msg-cell { max-width: 420px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
    .msg-cell.expanded { white-space: normal; }
</style>

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-page="/Jobs" class="btn btn-outline-secondary btn-sm">&#8592; Back to Dashboard</a>
    <div>
        <h2 class="mb-0 fw-bold">@Model.JobName</h2>
        <small class="text-muted">Run history &amp; step details</small>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    @* ── Summary stats ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value">@Model.TotalRuns</div>
                <div class="ds-label">Total Runs</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value text-success">@Model.SuccessCount</div>
                <div class="ds-label">Successes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value @(Model.FailureCount > 0 ? "text-danger" : "text-muted")">@Model.FailureCount</div>
                <div class="ds-label">Failures</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                @{
                    var avg = Model.AvgDurationSeconds;
                    var avgText = avg.HasValue
                        ? avg.Value >= 60 ? $"{(int)(avg.Value / 60)}m {(int)(avg.Value % 60)}s"
                                          : $"{(int)avg.Value}s"
                        : "—";
                    var healthPct = Model.TotalRuns == 0 ? 100.0
                        : Math.Round((double)Model.SuccessCount / Model.TotalRuns * 100, 1);
                    var hColor = healthPct >= 90 ? "text-success" : healthPct >= 60 ? "text-warning" : "text-danger";
                }
                <div class="ds-value @hColor">@healthPct%</div>
                <div class="ds-label">Success Rate</div>
            </div>
        </div>
    </div>

    @* ── Job-level run history ── *@
    <div class="card section-card">
        <div class="card-header py-3">Job Run History (last @jobRuns.Count runs)</div>
        <div class="card-body p-0">
            @if (!jobRuns.Any())
            {
                <p class="p-3 text-muted">No run history found for this job.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Run Date / Time</th>
                                <th>Status</th>
                                <th class="text-center">Duration</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in jobRuns)
                            {
                                var sc = run.RunStatus switch
                                {
                                    "Succeeded"   => "bg-success",
                                    "Failed"      => "bg-danger",
                                    "In Progress" => "bg-primary",
                                    "Retry"       => "bg-warning text-dark",
                                    "Cancelled"   => "bg-warning text-dark",
                                    _             => "bg-secondary"
                                };
                                var dur = run.DurationSeconds >= 60
                                    ? $"{run.DurationSeconds / 60}m {run.DurationSeconds % 60}s"
                                    : $"{run.DurationSeconds}s";
                                <tr>
                                    <td class="ps-3">@run.RunDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="badge @sc">@run.RunStatus</span></td>
                                    <td class="text-center text-muted small">@dur</td>
                                    <td>
                                        <span class="msg-cell small text-muted"
                                              title="@run.Message"
                                              onclick="this.classList.toggle('expanded')">@run.Message</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Step-level run details ── *@
    @if (stepRuns.Any())
    {
        <div class="card section-card">
            <div class="card-header py-3">Step-Level Run Details</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Run Date / Time</th>
                                <th class="text-center">Step #</th>
                                <th>Step Name</th>
                                <th>Status</th>
                                <th class="text-center">Duration</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var step in stepRuns)
                            {
                                var sc = step.RunStatus switch
                                {
                                    "Succeeded"   => "bg-success",
                                    "Failed"      => "bg-danger",
                                    "In Progress" => "bg-primary",
                                    "Retry"       => "bg-warning text-dark",
                                    "Cancelled"   => "bg-warning text-dark",
                                    _             => "bg-secondary"
                                };
                                var dur = step.DurationSeconds >= 60
                                    ? $"{step.DurationSeconds / 60}m {step.DurationSeconds % 60}s"
                                    : $"{step.DurationSeconds}s";
                                <tr>
                                    <td class="ps-3 small">@step.RunDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="text-center text-muted small">@step.StepId</td>
                                    <td class="small">@step.StepName</td>
                                    <td><span class="badge @sc">@step.RunStatus</span></td>
                                    <td class="text-center text-muted small">@dur</td>
                                    <td>
                                        <span class="msg-cell small text-muted"
                                              title="@step.Message"
                                              onclick="this.classList.toggle('expanded')">@step.Message</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
