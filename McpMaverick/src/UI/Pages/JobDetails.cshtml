@page
@model JobDetailsModel
@{
    ViewData["Title"] = $"Job Details – {Model.JobName}";
}

<style>
    .detail-stat { border-radius: .75rem; padding: 1rem 1.25rem; background: #f8f9fa; border: 1px solid #e9ecef; }
    .detail-stat .ds-value { font-size: 1.6rem; font-weight: 700; }
    .detail-stat .ds-label { font-size: .78rem; color: #6c757d; margin-top: .15rem; }
    .section-card { border: none; border-radius: .75rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 1.5rem; }
    .section-card .card-header { background: transparent; border-bottom: 1px solid #f0f0f0; font-weight: 600; }
    .table th { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: #6c757d; }
    .msg-cell { max-width: 420px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
    .msg-cell.expanded { white-space: normal; }
</style>

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-page="/Jobs" class="btn btn-outline-secondary btn-sm">&#8592; Back to Dashboard</a>
    <div>
        <h2 class="mb-0 fw-bold">@Model.JobName</h2>
        <small class="text-muted">Action history from Job Guardian AI</small>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    @* ── Job Status ── *@
    @if (Model.Job is not null)
    {
        var job = Model.Job;
        var statusClass = job.CurrentStatus switch
        {
            "Succeeded"   => "bg-success",
            "Failed"      => "bg-danger",
            "In Progress" => "bg-primary",
            "Retry"       => "bg-warning text-dark",
            "Cancelled"   => "bg-warning text-dark",
            _             => "bg-secondary"
        };
        <div class="card section-card mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <span>Current Job Status</span>
                <span class="badge @statusClass">@job.CurrentStatus</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <div class="detail-stat">
                            <div class="ds-value small fw-semibold text-truncate">@job.ServerName</div>
                            <div class="ds-label">Server</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="detail-stat">
                            <div class="ds-value small fw-semibold">
                                @if (job.IsEnabled)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Disabled</span>
                                }
                            </div>
                            <div class="ds-label">State</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="detail-stat">
                            <div class="ds-value small fw-semibold">
                                @(job.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
                            </div>
                            <div class="ds-label">Last Execution</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="detail-stat">
                            <div class="ds-value small fw-semibold">@job.FormattedDuration</div>
                            <div class="ds-label">Last Duration</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(job.FailureMessage))
                    {
                        <div class="col-12">
                            <div class="detail-stat">
                                <div class="ds-label mb-1">Last Error</div>
                                <div class="small text-danger msg-cell" title="@job.FailureMessage"
                                     onclick="this.classList.toggle('expanded')">@job.FailureMessage</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @* ── Summary stats ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value">@Model.TotalActions</div>
                <div class="ds-label">Total Actions</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value text-success">@Model.SuccessCount</div>
                <div class="ds-label">Succeeded</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value @(Model.FailureCount > 0 ? "text-danger" : "text-muted")">@Model.FailureCount</div>
                <div class="ds-label">Failed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="detail-stat">
                <div class="ds-value @(Model.PendingCount > 0 ? "text-warning" : "text-muted")">@Model.PendingCount</div>
                <div class="ds-label">Pending Approval</div>
            </div>
        </div>
    </div>

    @* ── Action History from DAB ── *@
    <div class="card section-card">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <span>Action History</span>
            @if (Model.ActionHistory.Any())
            {
                <span class="badge bg-secondary rounded-pill">@Model.ActionHistory.Count</span>
            }
        </div>
        <div class="card-body p-0">
            @if (!Model.ActionHistory.Any())
            {
                <p class="p-3 text-muted">No action history found for this job.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Date / Time</th>
                                <th>Action</th>
                                <th>Result</th>
                                <th>MCP Tool</th>
                                <th>Executed By</th>
                                <th>Root Cause / Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.ActionHistory)
                            {
                                var resultClass = entry.ActionResult switch
                                {
                                    "Success"          => "bg-success",
                                    "Failed"           => "bg-danger",
                                    "Pending Approval" => "bg-warning text-dark",
                                    _                  => "bg-secondary"
                                };
                                <tr>
                                    <td class="ps-3 small">@entry.ExecutedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="fw-semibold small">@entry.ActionName</td>
                                    <td><span class="badge @resultClass">@entry.ActionResult</span></td>
                                    <td class="text-muted small">@(entry.McpTool ?? "—")</td>
                                    <td class="text-muted small">@(entry.ExecutedBy ?? "—")</td>
                                    <td>
                                        @{
                                            var detail = entry.RootCause ?? entry.ErrorMessage;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(detail))
                                        {
                                            <span class="msg-cell small text-muted"
                                                  title="@detail"
                                                  onclick="this.classList.toggle('expanded')">@detail</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
