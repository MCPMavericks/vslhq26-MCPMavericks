@page
@model JobsModel
@{
    ViewData["Title"] = "Operations Dashboard";
}

<style>
    .stat-card {
        border-radius: .75rem;
        padding: 1.25rem 1.5rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .stat-card .stat-icon {
            font-size: 2rem;
            opacity: .85;
        }

        .stat-card .stat-value {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
        }

        .stat-card .stat-label {
            font-size: .8rem;
            opacity: .85;
            margin-top: .15rem;
        }

    .stat-total {
        background: linear-gradient(135deg, #6f42c1, #9a6fe8);
    }

    .stat-healthy {
        background: linear-gradient(135deg, #198754, #2dc888);
    }

    .stat-failed {
        background: linear-gradient(135deg, #dc3545, #f26b78);
    }

    .stat-running {
        background: linear-gradient(135deg, #fd7e14, #fdad6b);
    }

    .stat-disabled {
        background: linear-gradient(135deg, #6c757d, #9eaab7);
    }

    .fill-row {
        flex: 1 1 0;
        min-height: 0;
    }

    .fill-row .card.section-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        margin-bottom: 0;
    }

    .fill-row .card-body {
        flex: 1 1 0;
        overflow-y: auto;
        min-height: 0;
    }

    .page-fill {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 120px);
    }

    .section-card {
        border: none;
        border-radius: .75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        margin-bottom: 1.5rem;
    }

        .section-card .card-header {
            background: transparent;
            border-bottom: 1px solid #f0f0f0;
            font-weight: 600;
            font-size: 1rem;
        }

    .failure-item {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .6rem 0;
        border-bottom: 1px solid #f5f5f5;
    }

        .failure-item:last-child {
            border-bottom: none;
        }

    .failure-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .table th {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
    }

    .sortable {
        cursor: pointer;
        user-select: none;
    }

        .sortable:hover {
            color: #0d6efd;
        }
</style>

<div class="page-fill">
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    @* ── Stat cards ── *@
    <div class="row g-3 mb-4" style="margin:0px;">
        <div class="col-6 col-md-4 col-xl">
            <div class="stat-card stat-total h-100">
                <div class="stat-icon">&#128202;</div>
                <div>
                    <div class="stat-value">@Model.TotalJobs</div>
                    <div class="stat-label">Total Jobs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="stat-card stat-healthy h-100">
                <div class="stat-icon">&#10084;</div>
                <div>
                    <div class="stat-value">@Model.HealthyJobs</div>
                    <div class="stat-label">Healthy</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="stat-card stat-failed h-100">
                <div class="stat-icon">&#10060;</div>
                <div>
                    <div class="stat-value">@Model.FailedJobs</div>
                    <div class="stat-label">Failed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="stat-card stat-running h-100">
                <div class="stat-icon">&#9654;</div>
                <div>
                    <div class="stat-value">@Model.RunningJobs</div>
                    <div class="stat-label">Running</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="stat-card stat-disabled h-100">
                <div class="stat-icon">&#128683;</div>
                <div>
                    <div class="stat-value">@Model.DisabledJobs</div>
                    <div class="stat-label">Disabled</div>
                </div>
            </div>
        </div>
    </div>

    @* ── All Jobs (60%) + Recent Failures (40%) ── *@
    <div class="row g-3 fill-row">

        @* All Jobs — 60% *@
        <div class="col-md-7">
            <div class="card section-card h-100">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <span>All Jobs</span>
                    <div class="input-group input-group-sm" style="max-width:260px;">
                        <span class="input-group-text bg-body border-end-0"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11" /></svg></span>
                        <input id="jobFilter" type="text" class="form-control border-start-0" placeholder="Filter jobs…" oninput="filterJobs(this.value)">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="jobTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3 sortable" onclick="sortTable(0)">Job Name &#8645;</th>
                                    <th class="sortable" onclick="sortTable(1)">Enabled &#8645;</th>
                                    <th class="sortable" onclick="sortTable(2)">Status &#8645;</th>
                                    <th class="sortable" onclick="sortTable(3)">Last Execution &#8645;</th>
                                    <th class="sortable" onclick="sortTable(4)">Owner &#8645;</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.Jobs)
                                {
                                    var statusClass = job.CurrentStatus switch
                                    {
                                        "Succeeded" => "bg-success",
                                        "Failed" => "bg-danger",
                                        "In Progress" => "bg-primary",
                                        "Retry" => "bg-warning text-dark",
                                        "Cancelled" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3 fw-semibold">@job.JobName</td>
                                        <td>
                                            @if (job.IsEnabled)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Enabled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Disabled</span>
                                            }
                                        </td>
                                        <td><span class="badge @statusClass">@job.CurrentStatus</span></td>
                                        <td class="text-muted small">
                                            @(job.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
                                        </td>
                                        <td class="text-muted small">@(job.JobOwner ?? "—")</td>
                                        <td class="text-end pe-3">
                                            <a asp-page="/JobDetails" asp-route-jobName="@job.JobName" asp-route-jobId="@job.JobId"
                                               class="btn btn-outline-primary btn-sm">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* Recent Failures — 40% *@
        <div class="col-md-5">
            <div class="card section-card h-100">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <span>Recent Failures</span>
                    @if (Model.RecentFailures.Any())
                    {
                        <span class="badge bg-danger rounded-pill">@Model.FailedJobs</span>
                    }
                </div>
                <div class="card-body py-2">
                    @if (!Model.RecentFailures.Any())
                    {
                        <p class="text-success mt-2"><strong>&#10003;</strong> No recent failures — all clear!</p>
                    }
                    else
                    {
                        @foreach (var job in Model.RecentFailures)
                        {
                            <div class="failure-item">
                                <div class="failure-dot bg-danger"></div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold text-truncate small">@job.JobName</div>
                                    <div class="text-muted" style="font-size:.75rem">
                                        @(job.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(job.FailureMessage))
                                    {
                                        <div class="text-danger" style="font-size:.72rem" title="@job.FailureMessage">
                                            @(job.FailureMessage.Length > 80 ? job.FailureMessage[..80] + "…" : job.FailureMessage)
                                        </div>
                                    }
                                </div>
                                <a asp-page="/JobDetails" asp-route-jobName="@job.JobName" asp-route-jobId="@job.JobId"
                                   class="badge bg-danger text-decoration-none">FAILED</a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
}
</div>

@section Scripts {
    <script>
        function filterJobs(val) {
            const filter = val.toLowerCase();
            document.querySelectorAll('#jobTable tbody tr').forEach(row => {
                row.style.display = row.cells[0].textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        }

        let sortDir = {};
        function sortTable(col) {
            const tbody = document.querySelector('#jobTable tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            sortDir[col] = !sortDir[col];
            rows.sort((a, b) => {
                const av = a.cells[col]?.textContent.trim() ?? '';
                const bv = b.cells[col]?.textContent.trim() ?? '';
                const n = parseFloat(av) - parseFloat(bv);
                const cmp = isNaN(n) ? av.localeCompare(bv) : n;
                return sortDir[col] ? cmp : -cmp;
            });
            rows.forEach(r => tbody.appendChild(r));
        }
    </script>
}

